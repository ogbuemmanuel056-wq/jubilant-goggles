# Required for production admin authentication and submissions
DATABASE_URL=postgresql://user:password@host/database

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret

# Automatic loan application emails (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Turbo Credit <applications@your-verified-domain.com>
ADMIN_NOTIFICATION_EMAIL=your-admin@example.com

# Private Vercel Blob storage for applicant documents
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# ClamAV-compatible internal malware scanner endpoint
CLAMAV_SCAN_URL=https://scanner.internal.example/scan

# Sentry monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-public-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project
